# Copiar a .env y completar. En el droplet vive en ~/control-stock/.env.

# Lecturas: el inventario completo del stock-proxy (GET /v1/inventario).
# Dentro del droplet se usa la URL interna de Docker; desde fuera,
# https://stock.plantaspanama.com/v1. La clave es propia de esta app (una
# entrada más en STOCK_API_KEYS del proxy, revocable por separado).
STOCK_PROXY_URL=http://stock-proxy-stock-proxy-1:8100/v1
STOCK_API_KEY=CLAVE_1

# Escrituras: los ajustes de inventario van al order-api
# (POST /api/stock/ajustes), nunca a Odoo directo.
ORDER_API_URL=http://order-api-order-api-1:8083
ORDER_API_KEY=CLAVE_2

# En producción (detrás de nginx con HTTPS) la cookie de sesión sale Secure.
COOKIE_SEGURA=1

# Opcionales (el compose ya los fija en el contenedor):
# CONTROL_STOCK_DB=/datos/control-stock.db
# CONTROL_STOCK_ARCHIVOS=/datos/archivos

# Sin STOCK_PROXY_URL/STOCK_API_KEY la app arranca con datos de prueba y sin
# ORDER_API_URL/ORDER_API_KEY los ajustes se simulan: útil en desarrollo,
# jamás en el droplet.
