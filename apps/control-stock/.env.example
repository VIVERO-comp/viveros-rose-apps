# Copiar a .env y completar. En el droplet vive en ~/control-stock/.env.

# Lecturas: el inventario completo del stock-proxy (GET /v1/inventario).
# Dentro del droplet se usa la URL interna de Docker; desde fuera,
# https://stock.plantaspanama.com/v1. La clave es propia de esta app (una
# entrada más en STOCK_API_KEYS del proxy, revocable por separado).
STOCK_PROXY_URL=http://stock-proxy-stock-proxy-1:8100/v1
STOCK_API_KEY=CLAVE_1

# Escrituras: los ajustes de inventario van al order-api
# (POST /api/stock/ajustes), nunca a Odoo directo.
ORDER_API_URL=http://order-api-order-api-1:8083
ORDER_API_KEY=CLAVE_2

# En producción (detrás de nginx con HTTPS) la cookie de sesión sale Secure.
COOKIE_SEGURA=1

# Login con Google (la entrada principal desde el 16/09/2026; el formulario
# de usuario/contraseña queda de respaldo). Cliente OAuth en Google Cloud
# Console con esta redirect URI autorizada:
#   https://inventario.plantaspanama.com/auth/google/callback
#   https://inventario.plantaspanama.com/calendario/google/callback
# (la segunda es "Conectar mi Google Calendar" en Ajustes, 22/09/2026; usa
# las mismas credenciales con el scope calendar.events).
# Sin estas dos variables el botón de Google no aparece.
GOOGLE_CLIENT_ID=CLAVE_9
GOOGLE_CLIENT_SECRET=CLAVE_10

# Base pública de la app: arma la redirect URI de Google y los enlaces de
# factura por WhatsApp (detrás de nginx la app ve URLs internas http).
PUBLIC_BASE_URL=https://inventario.plantaspanama.com

# Quién ve la pestaña Ajustes (invitar y revocar accesos): emails de Google
# o usuarios de contraseña, separados por coma. Estos emails además pueden
# entrar con Google sin invitación previa (alguien tiene que entrar primero).
AJUSTES_ADMINS=correo1@gmail.com,correo2@gmail.com

# SOLO DESARROLLO LOCAL: con SIN_LOGIN=<usuario> la app entra sola como ese
# usuario, sin pantalla de login (pedido del dueño, 22/09/2026). NUNCA se
# pone en el droplet/producción; ahí la variable no debe existir.
# SIN_LOGIN=devlocal

# Opcionales (el compose ya los fija en el contenedor):
# CONTROL_STOCK_DB=/datos/control-stock.db
# CONTROL_STOCK_ARCHIVOS=/datos/archivos

# Sin STOCK_PROXY_URL/STOCK_API_KEY la app arranca con datos de prueba y sin
# ORDER_API_URL/ORDER_API_KEY los ajustes se simulan: útil en desarrollo,
# jamás en el droplet.

# Crear Venta (página /venta): conexión XML-RPC directa a Odoo, la ÚNICA
# excepción a la regla "la app nunca toca Odoo directo". Sin estas cuatro
# variables la página muestra un aviso y no ofrece acciones. OJO: los PDF
# (cotización/factura) usan sesión web, que exige una contraseña real de
# login; una API key solo sirve para el resto (XML-RPC).
ODOO_URL=https://odoo.plantaspanama.com
ODOO_DB=abraham_kortovich
ODOO_USER=CLAVE_3
ODOO_PASSWORD=CLAVE_4

# Ids fijos en Odoo (creados una sola vez con el OK del dueño, 08/09/2026):
# diarios de pago, etiqueta de las órdenes locales y cliente genérico.
# En la base de pruebas (abraham_kortovich_pruebas) VENTA_CLIENTE_LOCAL=68.
VENTA_DIARIO_YAPPY=9
VENTA_DIARIO_EFECTIVO=10
VENTA_TAG_LOCAL=1
VENTA_CLIENTE_LOCAL=74

# Opcional: carpeta del caché de fotos de producto (TTL 24 horas).
# VENTA_FOTOS_DIR=/datos/fotos_productos

# Cambiar la foto de un producto (el pincel del modal de foto en Stock):
# subida firmada a Cloudinary bajo apps/{SKU} — el namespace interno, la
# tienda pública nunca lo ve. Son las MISMAS credenciales del pipeline de
# fotos del catálogo (viveros-rose-frontend/.env en la Mac del dueño).
# Sin estas tres variables el pincel no aparece: el modal queda solo de
# zoom y descarga.
CLOUDINARY_CLOUD_NAME=CLAVE_5
CLOUDINARY_API_KEY=CLAVE_6
CLOUDINARY_API_SECRET=CLAVE_7

# Pestaña Fichas (descripción y guía de cuidado curadas para la tienda).
# TIENDA_DSN: la base `tienda` en el Postgres del droplet (contenedor
# odoo-db), la misma del order-api; tabla fichas_producto (migración 015).
# Sin TIENDA_DSN las fichas caen al SQLite local (solo desarrollo).
# FICHAS_EDITORES: quién ve y edita la pestaña. "*" = todos los usuarios
# de la app (lo vigente, decisión del dueño 11/09/2026); una lista de
# usuarios separados por coma la limita; sin la variable, nadie la ve.
TIENDA_DSN=CLAVE_8
FICHAS_EDITORES=*

# Calendario del equipo (pestaña Calendario): espejo del proyecto
# CALENDARIO ROSE de Linear. Sin estas variables la pantalla corre con
# actividades de muestra y no sale nada del droplet.
LINEAR_API_KEY=CLAVE_11
LINEAR_TEAM_CALENDARIO_ID=CLAVE_12
LINEAR_PROJECT_CALENDARIO_ID=CLAVE_13
# Interruptor de escrituras: con 0 (o sin la variable) la pantalla LEE el
# calendario real pero no escribe en Linear. Es lo que usa la instancia de
# pruebas, porque no existe un Linear de pruebas.
CALENDARIO_ESCRITURA=0

# Retail y CRM: 0 las saca del MENU y nada mas (el dueno, 24/09/2026:
# "que no se vea en el inventario pero dejalo activo"). Las pantallas
# siguen vivas en /retail y /crm para quien entre con la URL.
RETAIL_EN_MENU=1
CRM_EN_MENU=1

# Espejo de las ventas de Vender en el CRM (22/09/2026): el puente
# /api/crm/lead-inventario del frontend en Vercel crea o reutiliza el lead
# en Linear/Twenty (label "Hecha desde inventario") y devuelve la
# referencia PP-XXXXX con la que se amarra la oportunidad del Flujo.
# CRM_LEADS_SECRETO es el MISMO valor que INVENTARIO_LEAD_SECRET en las
# env vars de Vercel (generar con openssl rand -hex 32). Sin estas
# variables el espejo queda apagado y las ventas siguen normal.
CRM_LEADS_URL=https://www.plantaspanama.com
CRM_LEADS_SECRETO=CLAVE_14

# El calendario con piel de Twenty (/crm/calendario), mostrado dentro del
# Twenty real como una pestaña (iframe, igual que Chats). CRM_PUBLIC_BASE_URL
# es la URL con la que la gente lo abre (el callback de Google del CRM debe
# estar autorizado en el OAuth Client: CRM_PUBLIC_BASE_URL/crm/auth/google/callback).
# TWENTY_API_KEY (Settings -> Developers de Twenty) da la ficha del lead:
# teléfono y conversación de WhatsApp, SOLO lectura. Sin la clave, la ficha
# muestra lo que da Linear y ya.
CRM_PUBLIC_BASE_URL=https://crm.plantaspanama.com
TWENTY_URL=https://crm.plantaspanama.com
TWENTY_API_KEY=CLAVE_15

# Avisos Web Push al celular del equipo (23/09/2026): un lead que gana la
# etiqueta «Te toca» le suena el celular al encargado de contestar, aunque
# tenga la app cerrada. (Hasta la Fase 5 el disparador era la columna
# "Esperando respuesta" del kanban de chats, que ya no existe.) Son las MISMAS claves VAPID del order-api
# (el par sirve para cualquier origen); la suscripción sí es propia de
# inventario.plantaspanama.com. Sin las claves la app arranca igual y los
# avisos quedan en el log.
VAPID_CLAVE_PUBLICA=CLAVE_17
VAPID_CLAVE_PRIVADA=CLAVE_18
VAPID_CORREO=info@viverorose.com
# A quién le llegan los avisos de los chats: el usuario de la app del
# encargado de contestar WhatsApp (decisión de Abraham: Rubén).
AVISOS_CHATS_USUARIO=ruben@viverorose.com
