# Copiar a .env y completar. Sin estas variables la app arranca igual, con
# los datos de prueba del prototipo (sucursales y catalogo simulados).

# Stock proxy (VIVERO-comp/vivero-rose-stock-proxy): sucursales de
# supermercado y catalogo PLT- en vivo desde Odoo.
STOCK_PROXY_URL=https://stock.plantaspanama.com/v1
STOCK_API_KEY=CLAVE_1

# En producción (detrás de nginx con HTTPS): la cookie de sesión viaja solo
# por HTTPS. En desarrollo local por http, dejarla sin definir.
# COOKIE_SEGURA=1

# Opcional: ruta del archivo SQLite con el estado local (por defecto,
# recepcion.db junto a la app).
# RECEPCION_DB=/ruta/a/recepcion.db
