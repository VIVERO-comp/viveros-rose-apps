# Copiar a .env y completar. Sin estas variables la app arranca con
# sucursales y catalogo de prueba y CERO entregas (no se inventan pedidos).

# Stock proxy (VIVERO-comp/vivero-rose-stock-proxy): pedidos, sucursales y
# catalogo en vivo desde Odoo. En el droplet se usa la red interna de Docker:
#   STOCK_PROXY_URL=http://stock-proxy-stock-proxy-1:8100/v1
STOCK_PROXY_URL=https://stock.plantaspanama.com/v1
STOCK_API_KEY=CLAVE_1

# En producción (detrás de nginx con HTTPS): la cookie de sesión viaja solo
# por HTTPS. En desarrollo local por http, dejarla sin definir.
# COOKIE_SEGURA=1

# Opcional: ruta del archivo SQLite con el estado local (por defecto,
# recepcion.db junto a la app).
# RECEPCION_DB=/ruta/a/recepcion.db
